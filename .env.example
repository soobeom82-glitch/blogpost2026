# Copy to .env.local. Never commit credentials.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_ADSENSE_CLIENT=

# Required on Vercel. Existing POSTGRES_URL / POSTGRES_PRISMA_URL also work.
DATABASE_URL=
# Required in production; random, private, at least 32 characters.
ENGAGEMENT_SECRET=
# Required when daily reports are enabled; Vercel supplies it as a Bearer token.
CRON_SECRET=
COMMENT_ADMIN_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local/test only. Default: data/blog-store.json. Vercel never uses JSON storage.
# BLOG_STORE_PATH=/absolute/path/to/local-store.json
